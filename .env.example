# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# ClickHouse 日志数据库连接字符串示例
# LOG_SQL_DSN=clickhouse://default:password@127.0.0.1:9000/logdb
# ClickHouse 日志 TTL 天数，0 表示不设置 TTL
# LOG_SQL_CLICKHOUSE_TTL_DAYS=0
# 启动时自动迁移旧日志到日志数据库，并在成功后清空主库 logs
# AUTO_MIGRATE_OLD_LOGS_TO_LOG_DB=true
# 旧独立日志数据库连接字符串；配置后会从该库迁移到当前 LOG_SQL_DSN
# OLD_LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/old_logdb?parseTime=true
# 日志迁移批次大小
# LOG_MIGRATION_BATCH_SIZE=10000
# 允许迁移到非空日志库，默认关闭
# ALLOW_LOG_MIGRATION_TO_NON_EMPTY_TARGET=false
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 慢查询日志阈值（毫秒），0 表示关闭；超出 0-3600000 范围回退到默认值 200
# SQL_SLOW_THRESHOLD_MS=200
# 日志数据库最大空闲连接数，未设置时回退到 SQL_MAX_IDLE_CONNS
# LOG_SQL_MAX_IDLE_CONNS=100
# 日志数据库最大打开连接数，未设置时回退到 SQL_MAX_OPEN_CONNS
# LOG_SQL_MAX_OPEN_CONNS=1000
# 日志数据库连接最大生命周期（秒），未设置时回退到 SQL_MAX_LIFETIME
# LOG_SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 应用收到 SIGTERM 后等待在途请求退出的时间，必须小于容器 stop_grace_period
# SHUTDOWN_TIMEOUT_SECONDS=120

# 对话超时设置
# 旧版 Relay 超时，单位秒。对 Relay/供应商请求，仅在未配置
# RELAY_RESPONSE_HEADER_TIMEOUT_SECONDS 时作为等待响应头的兼容值（不超过480秒），不再限制
# 流式响应体的总读取时长；用户控制 URL 的 SSRF 保护下载仍将它作为整体下载超时
# RELAY_TIMEOUT=0
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认跟随 Go 标准库，设置为0表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# TCP 建连超时，单位秒，设置为0表示不限制
# RELAY_DIAL_TIMEOUT_SECONDS=10
# TLS 握手超时，单位秒，设置为0表示不限制
# RELAY_TLS_HANDSHAKE_TIMEOUT_SECONDS=10
# 单次尝试等待上游响应头超时，单位秒；同时受下面的跨尝试首事件总预算约束
# RELAY_RESPONSE_HEADER_TIMEOUT_SECONDS=480
# Expect: 100-continue 等待超时，单位秒
# RELAY_EXPECT_CONTINUE_TIMEOUT_SECONDS=1
# 响应头返回后等待首个有效 SSE 事件的单次尝试上限；仍受下面的跨尝试总预算限制
# RELAY_FIRST_EVENT_TIMEOUT_SECONDS=540
# 从入站请求开始、跨所有渠道尝试共享的首个有效事件总预算；首事件后自动解除，不截断健康长流
# 默认540秒，应早于海外 Caddy 首包超时至少60秒；0表示禁用这道总门禁
# RELAY_FIRST_EVENT_TOTAL_TIMEOUT_SECONDS=540
# 流式请求在首个有效事件前的 SSE 保活间隔，避免客户端/中继因长时间无字节而断开；0表示禁用
# RELAY_PRE_FIRST_EVENT_HEARTBEAT_SECONDS=15
# 首个有效事件之后，相邻有效 SSE data 事件的最大空闲时间；注释/PING 不会重置
# STREAMING_TIMEOUT=300
# 请求体解压后上限（MiB）；默认 128，超过返回 413
# MAX_REQUEST_BODY_MB=128
# 同时读取/解析的 >=1 MiB 请求体上限（包含磁盘暂存请求）；超过时返回 503。
# 请求解析完成后即释放准入槽，可重放的请求体存储仍保留到请求结束。
# MAX_CONCURRENT_LARGE_REQUEST_BODIES=4

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string
# 启用 Secure session cookie，必须同时配置可信 HTTPS 入口地址；多个地址用英文逗号分隔
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
